// Transforms are in TransformBuffer (binding 13), indexed by partIdx (globally unique).
// One thread per partIdx — no Flywheel instance buffer access, no PAGE/batch/slot math.
// Java wrote world-space from/goal keyframes for every tree node; GPU just interpolates.

layout(local_size_x = 32) in;

// ── Output: interpolated world-space matrices, one slot per partIdx ──
layout(std430, binding = 12) writeonly buffer OutputMatrices {
    mat4 finalPartMatrices[];
};

// ── Input: world-space from/goal keyframes, one entry per partIdx ──
struct PartTransform {
    vec3  posFrom;   float _p0;  // offset  0
    vec4  rotFrom;               // offset 16
    vec3  scaleFrom; float _p1;  // offset 32
    vec3  posGoal;   float _p2;  // offset 48
    vec4  rotGoal;               // offset 64
    vec3  scaleGoal; float _p3;  // offset 80
};                               // = 96 bytes

layout(std430, binding = 13) readonly buffer TransformBuffer {
    PartTransform transforms[];
};

// Total number of partIdx slots (highWaterMark + 1), set by Java dispatch mixin.
layout(location = 50) uniform uint partCount;

vec4 slerp(vec4 v0, vec4 v1, float t) {
    if (dot(v0, v0) < 0.0001) v0 = vec4(0.0, 0.0, 0.0, 1.0);
    if (dot(v1, v1) < 0.0001) v1 = vec4(0.0, 0.0, 0.0, 1.0);
    v0 = normalize(v0);
    v1 = normalize(v1);
    float d = dot(v0, v1);
    if (d < 0.0) { v1 = -v1; d = -d; }
    if (d > 0.9995) return normalize(mix(v0, v1, t));
    float theta0    = acos(d);
    float theta     = theta0 * t;
    float sinTheta  = sin(theta);
    float sinTheta0 = sin(theta0);
    return (cos(theta) - d * sinTheta / sinTheta0) * v0
         + (sinTheta / sinTheta0) * v1;
}

mat4 buildMatrix(vec3 pos, vec4 q, vec3 scale) {
    mat4 m;
    m[0][0] = (1.0 - 2.0*(q.y*q.y + q.z*q.z)) * scale.x;
    m[0][1] = (2.0*(q.x*q.y + q.w*q.z))        * scale.x;
    m[0][2] = (2.0*(q.x*q.z - q.w*q.y))        * scale.x;
    m[0][3] = 0.0;
    m[1][0] = (2.0*(q.x*q.y - q.w*q.z))        * scale.y;
    m[1][1] = (1.0 - 2.0*(q.x*q.x + q.z*q.z)) * scale.y;
    m[1][2] = (2.0*(q.y*q.z + q.w*q.x))        * scale.y;
    m[1][3] = 0.0;
    m[2][0] = (2.0*(q.x*q.z + q.w*q.y))        * scale.z;
    m[2][1] = (2.0*(q.y*q.z - q.w*q.x))        * scale.z;
    m[2][2] = (1.0 - 2.0*(q.x*q.x + q.y*q.y)) * scale.z;
    m[2][3] = 0.0;
    m[3]    = vec4(pos, 1.0);
    return m;
}

void main() {
    // gid IS partIdx — no instance buffer lookup needed.
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= partCount) return;

    float t = flw_partialTick;

    PartTransform p = transforms[gid];
    finalPartMatrices[gid] = buildMatrix(
        mix(p.posFrom,   p.posGoal,   t),
        slerp(p.rotFrom, p.rotGoal,   t),
        mix(p.scaleFrom, p.scaleGoal, t)
    );
}