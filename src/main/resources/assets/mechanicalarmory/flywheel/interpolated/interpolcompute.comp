// Flywheel injects FlwInstance, _flw_unpackInstance, and all uniforms automatically.

layout(local_size_x = 4) in; // one thread per segment (base/first/second/item)

// No page descriptor buffer needed — globalIdx is computed directly as
// segIdx * PAGE_SIZE + armIdx, which matches the observed layout.

layout(std430, binding = 12) buffer OutputMatrices {
    mat4 finalPartMatrices[];
};

layout(location = 50) uniform uint armsCount;

// Shared within a workgroup = shared within one arm's 4 threads.
shared mat4 localMats[4];

vec4 slerp(vec4 v0, vec4 v1, float t) {
    if (dot(v0, v0) < 0.0001) v0 = vec4(0.0, 0.0, 0.0, 1.0);
    if (dot(v1, v1) < 0.0001) v1 = vec4(0.0, 0.0, 0.0, 1.0);
    v0 = normalize(v0);
    v1 = normalize(v1);
    float d = dot(v0, v1);
    if (d < 0.0) { v1 = -v1; d = -d; }
    if (d > 0.9995) return normalize(mix(v0, v1, t));
    float theta0    = acos(d);
    float theta     = theta0 * t;
    float sinTheta  = sin(theta);
    float sinTheta0 = sin(theta0);
    return (cos(theta) - d * sinTheta / sinTheta0) * v0
         + (sinTheta / sinTheta0) * v1;
}

mat4 buildMatrix(vec3 pos, vec4 q, vec3 scale) {
    mat4 m;
    m[0][0] = (1.0 - 2.0*(q.y*q.y + q.z*q.z)) * scale.x;
    m[0][1] = (2.0*(q.x*q.y + q.w*q.z))        * scale.x;
    m[0][2] = (2.0*(q.x*q.z - q.w*q.y))        * scale.x;
    m[0][3] = 0.0;
    m[1][0] = (2.0*(q.x*q.y - q.w*q.z))        * scale.y;
    m[1][1] = (1.0 - 2.0*(q.x*q.x + q.z*q.z)) * scale.y;
    m[1][2] = (2.0*(q.y*q.z + q.w*q.x))        * scale.y;
    m[1][3] = 0.0;
    m[2][0] = (2.0*(q.x*q.z + q.w*q.y))        * scale.z;
    m[2][1] = (2.0*(q.y*q.z - q.w*q.x))        * scale.z;
    m[2][2] = (1.0 - 2.0*(q.x*q.x + q.y*q.y)) * scale.z;
    m[2][3] = 0.0;
    m[3]    = vec4(pos, 1.0);
    return m;
}

void main() {
    uint armIdx = gl_WorkGroupID.x;       // one workgroup per arm
    uint segIdx = gl_LocalInvocationID.x; // 0=base, 1=first, 2=second, 3=item

    if (armIdx >= armsCount) return;

    // Each segment group occupies one page of PAGE_SIZE=32 slots.
    // Segment s of arm a → globalIdx = s * 32 + a.
    uint globalIdx = segIdx * 32u + armIdx;

    FlwInstance i = _flw_unpackInstance(globalIdx);

    float t = flw_partialTick;

    // base: posFrom/posGoal are world-space   → world matrix directly.
    // others: posFrom/posGoal are local-space  → local matrix, chained below.
    localMats[segIdx] = buildMatrix(
        mix(i.posFrom, i.posGoal, t),
        slerp(i.rotFrom, i.rotGoal, t),
        mix(i.scaleFrom, i.scaleGoal, t)
    );

    // Wait for all 4 threads to finish writing their local matrix.
    barrier();
    memoryBarrierShared();

    // Thread 0 chains and writes world-space matrices for all 4 segments.
    if (segIdx == 0u) {
        mat4 base   = localMats[0];
        mat4 first  = base   * localMats[1];
        mat4 second = first  * localMats[2];
        mat4 item   = second * localMats[3];

        finalPartMatrices[armIdx]        = base;
        finalPartMatrices[32u + armIdx]  = first;
        finalPartMatrices[64u + armIdx]  = second;
        finalPartMatrices[96u + armIdx]  = item;
    }
}
