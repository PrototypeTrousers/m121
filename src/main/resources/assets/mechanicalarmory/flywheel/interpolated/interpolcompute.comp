// Flywheel injects FlwInstance, _flw_unpackInstance, and all uniforms automatically.

layout(local_size_x = 32) in; // one thread per page slot (PAGE_SIZE = 32)

// Bound at slot 0 by bindForCull(). Format per page: [modelIndex (u32), validBits (u32)]
layout(std430, binding = 0) readonly buffer PageFrameDescriptors {
    uint _flw_pageFrameDescriptors[];
};

// Output: unchained local matrices at finalPartMatrices[globalIdx].
// The vertex shader chains them using partIdx and globalIdx.
layout(std430, binding = 12) writeonly buffer OutputMatrices {
    mat4 finalPartMatrices[];
};

vec4 slerp(vec4 v0, vec4 v1, float t) {
    // Guard: zero quaternion means uninitialized — fall back to identity.
    if (dot(v0, v0) < 0.0001) v0 = vec4(0.0, 0.0, 0.0, 1.0);
    if (dot(v1, v1) < 0.0001) v1 = vec4(0.0, 0.0, 0.0, 1.0);

    v0 = normalize(v0);
    v1 = normalize(v1);
    float d = dot(v0, v1);
    if (d < 0.0) { v1 = -v1; d = -d; }
    if (d > 0.9995) return normalize(mix(v0, v1, t));
    float theta0    = acos(d);
    float theta     = theta0 * t;
    float sinTheta  = sin(theta);
    float sinTheta0 = sin(theta0);
    return (cos(theta) - d * sinTheta / sinTheta0) * v0
         + (sinTheta / sinTheta0) * v1;
}

mat4 buildMatrix(vec3 pos, vec4 q, vec3 scale) {
    mat4 m;
    m[0][0] = (1.0 - 2.0*(q.y*q.y + q.z*q.z)) * scale.x;
    m[0][1] = (2.0*(q.x*q.y + q.w*q.z))        * scale.x;
    m[0][2] = (2.0*(q.x*q.z - q.w*q.y))        * scale.x;
    m[0][3] = 0.0;
    m[1][0] = (2.0*(q.x*q.y - q.w*q.z))        * scale.y;
    m[1][1] = (1.0 - 2.0*(q.x*q.x + q.z*q.z)) * scale.y;
    m[1][2] = (2.0*(q.y*q.z + q.w*q.x))        * scale.y;
    m[1][3] = 0.0;
    m[2][0] = (2.0*(q.x*q.z + q.w*q.y))        * scale.z;
    m[2][1] = (2.0*(q.y*q.z - q.w*q.x))        * scale.z;
    m[2][2] = (1.0 - 2.0*(q.x*q.x + q.y*q.y)) * scale.z;
    m[2][3] = 0.0;
    m[3]    = vec4(pos, 1.0);
    return m;
}

void main() {
    uint pageIndex  = gl_WorkGroupID.x;
    uint slotInPage = gl_LocalInvocationID.x;

    uint validBits = _flw_pageFrameDescriptors[pageIndex * 2u + 1u];
    if (((1u << slotInPage) & validBits) == 0u) return;

    // Real position in the instance buffer — no contiguous assumption needed.
    uint globalIdx = pageIndex * 32u + slotInPage;

    FlwInstance i = _flw_unpackInstance(globalIdx);

    float t = flw_partialTick;

    // Write the unchained local matrix at this instance's exact globalIdx slot.
    // The vertex shader reads this slot via instanceIndices[] and chains up
    // to its segment depth using partIdx.
    finalPartMatrices[globalIdx] = buildMatrix(
        mix(i.posFrom, i.posGoal, t),
        slerp(i.rotFrom, i.rotGoal, t),
        mix(i.scaleFrom, i.scaleGoal, t)
    );
}
