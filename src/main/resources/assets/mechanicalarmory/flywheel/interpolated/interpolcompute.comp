// Flywheel injects FlwInstance, _flw_unpackInstance, and all uniforms automatically.

layout(local_size_x = 32) in; // one thread per arm

layout(std430, binding = 12) writeonly buffer OutputMatrices {
    mat4 finalPartMatrices[];
};

layout(location = 50) uniform uint armsCount;

vec4 slerp(vec4 v0, vec4 v1, float t) {
    if (dot(v0, v0) < 0.0001) v0 = vec4(0.0, 0.0, 0.0, 1.0);
    if (dot(v1, v1) < 0.0001) v1 = vec4(0.0, 0.0, 0.0, 1.0);
    v0 = normalize(v0);
    v1 = normalize(v1);
    float d = dot(v0, v1);
    if (d < 0.0) { v1 = -v1; d = -d; }
    if (d > 0.9995) return normalize(mix(v0, v1, t));
    float theta0    = acos(d);
    float theta     = theta0 * t;
    float sinTheta  = sin(theta);
    float sinTheta0 = sin(theta0);
    return (cos(theta) - d * sinTheta / sinTheta0) * v0
         + (sinTheta / sinTheta0) * v1;
}

mat4 buildMatrix(vec3 pos, vec4 q, vec3 scale) {
    mat4 m;
    m[0][0] = (1.0 - 2.0*(q.y*q.y + q.z*q.z)) * scale.x;
    m[0][1] = (2.0*(q.x*q.y + q.w*q.z))        * scale.x;
    m[0][2] = (2.0*(q.x*q.z - q.w*q.y))        * scale.x;
    m[0][3] = 0.0;
    m[1][0] = (2.0*(q.x*q.y - q.w*q.z))        * scale.y;
    m[1][1] = (1.0 - 2.0*(q.x*q.x + q.z*q.z)) * scale.y;
    m[1][2] = (2.0*(q.y*q.z + q.w*q.x))        * scale.y;
    m[1][3] = 0.0;
    m[2][0] = (2.0*(q.x*q.z + q.w*q.y))        * scale.z;
    m[2][1] = (2.0*(q.y*q.z - q.w*q.x))        * scale.z;
    m[2][2] = (1.0 - 2.0*(q.x*q.x + q.y*q.y)) * scale.z;
    m[2][3] = 0.0;
    m[3]    = vec4(pos, 1.0);
    return m;
}

mat4 interpolate(uint globalIdx, float t) {
    FlwInstance i = _flw_unpackInstance(globalIdx);
    return buildMatrix(
        mix(i.posFrom, i.posGoal, t),
        slerp(i.rotFrom, i.rotGoal, t),
        mix(i.scaleFrom, i.scaleGoal, t)
    );
}

void main() {
    uint armIdx = gl_GlobalInvocationID.x;
    if (armIdx >= armsCount) return;

    float t = flw_partialTick;

    // Pages are allocated per-segment in batches of PAGE_SIZE=32 arms.
    // Within a batch, all 4 segment groups are laid out consecutively,
    // each occupying one full page of 32 slots:
    //
    //   batch 0 (arms  0-31): pages 0-3  → globalIdx   0-127
    //   batch 1 (arms 32-63): pages 4-7  → globalIdx 128-255
    //   batch B (arms B*32..): pages B*4  → globalIdx B*128
    //
    // globalIdx for segment S of arm A:
    //   batch      = A / 32
    //   slot       = A % 32
    //   globalIdx  = batch * 128 + S * 32 + slot

    uint batch       = armIdx / 32u;
    uint slot        = armIdx & 31u;
    uint batchOffset = batch * 128u; // 4 segments * PAGE_SIZE = 4 * 32 = 128

    uint baseIdx   = batchOffset +  0u + slot;
    uint firstIdx  = batchOffset + 32u + slot;
    uint secondIdx = batchOffset + 64u + slot;
    uint itemIdx   = batchOffset + 96u + slot;

    mat4 base   = interpolate(baseIdx,   t); // world-space
    mat4 first  = base   * interpolate(firstIdx,  t); // local → world
    mat4 second = first  * interpolate(secondIdx, t);
    mat4 item   = second * interpolate(itemIdx,   t);

    finalPartMatrices[baseIdx]   = base;
    finalPartMatrices[firstIdx]  = first;
    finalPartMatrices[secondIdx] = second;
    finalPartMatrices[itemIdx]   = item;
}