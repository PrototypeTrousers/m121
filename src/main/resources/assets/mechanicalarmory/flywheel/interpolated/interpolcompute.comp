// Flywheel injects FlwInstance, _flw_unpackInstance, and all uniforms automatically.

layout(local_size_x = 4) in; // one thread per arm

layout(std430, binding = 12) writeonly buffer OutputMatrices {
    mat4 finalPartMatrices[];
};

layout(location = 50) uniform uint armsCount;

vec4 slerp(vec4 v0, vec4 v1, float t) {
    v0 = normalize(v0);
    v1 = normalize(v1);
    float d = dot(v0, v1);
    if (d < 0.0) { v1 = -v1; d = -d; }
    if (d > 0.9995) return normalize(mix(v0, v1, t));
    float theta0    = acos(d);
    float theta     = theta0 * t;
    float sinTheta  = sin(theta);
    float sinTheta0 = sin(theta0);
    return (cos(theta) - d * sinTheta / sinTheta0) * v0
    + (sinTheta / sinTheta0) * v1;
}

mat4 buildMatrix(vec3 pos, vec4 q, vec3 scale) {
    mat4 m;
    m[0][0] = (1.0 - 2.0*(q.y*q.y + q.z*q.z)) * scale.x;
    m[0][1] = (2.0*(q.x*q.y + q.w*q.z))        * scale.x;
    m[0][2] = (2.0*(q.x*q.z - q.w*q.y))        * scale.x;
    m[0][3] = 0.0;
    m[1][0] = (2.0*(q.x*q.y - q.w*q.z))        * scale.y;
    m[1][1] = (1.0 - 2.0*(q.x*q.x + q.z*q.z)) * scale.y;
    m[1][2] = (2.0*(q.y*q.z + q.w*q.x))        * scale.y;
    m[1][3] = 0.0;
    m[2][0] = (2.0*(q.x*q.z + q.w*q.y))        * scale.z;
    m[2][1] = (2.0*(q.y*q.z - q.w*q.x))        * scale.z;
    m[2][2] = (1.0 - 2.0*(q.x*q.x + q.y*q.y)) * scale.z;
    m[2][3] = 0.0;
    m[3]    = vec4(pos, 1.0);
    return m;
}

mat4 getLocalMatrix(uint logicalIdx, float t) {
    // 16 instances (4 arms x 4 segments) always fit in page 0,
    // so logical index == global buffer index directly.
    FlwInstance i = _flw_unpackInstance(logicalIdx);
    return buildMatrix(
    mix(i.posFrom, i.posGoal, t),
    slerp(i.rotFrom, i.rotGoal, t),
    mix(i.scaleFrom, i.scaleGoal, t)
    );
}

void main() {
    uint armIdx = gl_GlobalInvocationID.x;
    if (armIdx >= armsCount) return;

    float t = flw_partialTick;

    mat4 base   = getLocalMatrix(armIdx,                    t);
    mat4 first  = base   * getLocalMatrix(armIdx + armsCount,       t);
    mat4 second = first  * getLocalMatrix(armIdx + armsCount * 2u,  t);
    mat4 item   = second * getLocalMatrix(armIdx + armsCount * 3u,  t);

    // Write at the same logical index the instance occupies in the buffer.
    // The vertex shader reads finalPartMatrices[instanceIndex] directly.
    finalPartMatrices[armIdx]                  = base;
    finalPartMatrices[armIdx + armsCount]      = first;
    finalPartMatrices[armIdx + armsCount * 2u] = second;
    finalPartMatrices[armIdx + armsCount * 3u] = item;
}
