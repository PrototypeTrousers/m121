#version 430
layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InputInstances {
    float instances[];
};

layout(std430, binding = 12) writeonly buffer OutputMatrices {
    mat4 finalPartMatrices[];
};

layout(std140, binding = 0) uniform FlwFrameUniforms {
    mat4 viewProjection;
    vec4 flw_time;
    vec3 cameraPos;
};

// Target the exact manual location from our Mixin
layout(location = 50) uniform uint totalInstancesCount;

// Exactly 23 floats, matching your Java extra memory layout size perfectly
const uint STRIDE = 23u;
const uint OFF_POS_FROM   = 3u;
const uint OFF_ROT_FROM   = 6u;
const uint OFF_SCALE_FROM = 10u;
const uint OFF_POS_GOAL   = 13u;
const uint OFF_ROT_GOAL   = 16u;
const uint OFF_SCALE_GOAL = 20u;

vec4 slerp(vec4 v0, vec4 v1, float t) {
    v0 = normalize(v0);
    v1 = normalize(v1);
    float dotProduct = dot(v0, v1);

    if (dotProduct < 0.0) {
        v1 = -v1;
        dotProduct = -dotProduct;
    }

    if (dotProduct > 0.9995) {
        return normalize(mix(v0, v1, t));
    }

    float theta_0 = acos(dotProduct);
    float theta = theta_0 * t;
    float sin_theta = sin(theta);
    float sin_theta_0 = sin(theta_0);

    float s0 = cos(theta) - dotProduct * sin_theta / sin_theta_0;
    float s1 = sin_theta / sin_theta_0;
    return (s0 * v0) + (s1 * v1);
}

mat4 buildMatrix(vec3 pos, vec4 q, vec3 scale) {
    mat4 m;
    m[0][0] = (1.0 - 2.0 * (q.y * q.y + q.z * q.z)) * scale.x;
    m[0][1] = (2.0 * (q.x * q.y + q.w * q.z)) * scale.x;
    m[0][2] = (2.0 * (q.x * q.z - q.w * q.y)) * scale.x;
    m[0][3] = 0.0;

    m[1][0] = (2.0 * (q.x * q.y - q.w * q.z)) * scale.y;
    m[1][1] = (1.0 - 2.0 * (q.x * q.x + q.z * q.z)) * scale.y;
    m[1][2] = (2.0 * (q.y * q.z + q.w * q.x)) * scale.y;
    m[1][3] = 0.0;

    m[2][0] = (2.0 * (q.x * q.z + q.w * q.y)) * scale.z;
    m[2][1] = (2.0 * (q.y * q.z - q.w * q.x)) * scale.z;
    m[2][2] = (1.0 - 2.0 * (q.x * q.x + q.y * q.y)) * scale.z;
    m[2][3] = 0.0;

    m[3][0] = pos.x;
    m[3][1] = pos.y;
    m[3][2] = pos.z;
    m[3][3] = 1.0;
    return m;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // Completely bound-safe. Processes every uploaded part effortlessly.
    if (idx >= totalInstancesCount) return;

    float t = fract(flw_time.x);
    uint base = idx * STRIDE;

    vec3 posFrom   = vec3(instances[base + OFF_POS_FROM],     instances[base + OFF_POS_FROM + 1u],   instances[base + OFF_POS_FROM + 2u]);
    vec4 rotFrom   = vec4(instances[base + OFF_ROT_FROM],     instances[base + OFF_ROT_FROM + 1u],   instances[base + OFF_ROT_FROM + 2u],   instances[base + OFF_ROT_FROM + 3u]);
    vec3 scaleFrom = vec3(instances[base + OFF_SCALE_FROM],   instances[base + OFF_SCALE_FROM + 1u], instances[base + OFF_SCALE_FROM + 2u]);

    vec3 posGoal   = vec3(instances[base + OFF_POS_GOAL],     instances[base + OFF_POS_GOAL + 1u],   instances[base + OFF_POS_GOAL + 2u]);
    vec4 rotGoal   = vec4(instances[base + OFF_ROT_GOAL],     instances[base + OFF_ROT_GOAL + 1u],   instances[base + OFF_ROT_GOAL + 2u],   instances[base + OFF_ROT_GOAL + 3u]);
    vec3 scaleGoal = vec3(instances[base + OFF_SCALE_GOAL],   instances[base + OFF_SCALE_GOAL + 1u], instances[base + OFF_SCALE_GOAL + 2u]);

    vec3 mixedPos   = mix(posFrom, posGoal, t);
    vec4 mixedRot   = slerp(rotFrom, rotGoal, t);
    vec3 mixedScale = mix(scaleFrom, scaleGoal, t);

    // Write 1 matrix per instance smoothly. No cross-indexing bounds needed!
    finalPartMatrices[idx] = buildMatrix(mixedPos, mixedRot, mixedScale);
}